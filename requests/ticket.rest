@baseURL = http://localhost:3000

### Listar todas os chamados
GET {{baseURL}}/chamados
Accept: application/json

### Listar chamados por status ABERTO
GET {{baseURL}}/chamados?status=ABERTO
Accept: application/json

### Listar chamados por status inválido
GET {{baseURL}}/chamados?status=123
Accept: application/json

### Listar chamados por prioridade ALTA
GET {{baseURL}}/chamados?prioridade=ALTA
Accept: application/json

### Listar chamados por prioridade inválido
GET {{baseURL}}/chamados?prioridade=123
Accept: application/json

### Listar chamados por prioridade e status
GET {{baseURL}}/chamados?prioridade=media&status=em_atendimento
Accept: application/json

### Criar chamado
POST {{baseURL}}/chamados
Accept: application/json
content-type: application/json

{
  "titulo": "Monitor com tela piscando",
  "descricao": "O monitor apresenta oscilações na imagem durante o uso.",
  "prioridade": "ALTA",
  "solicitanteId": 4,
  "categoriaId": 1
}

### Criar chamado sem dados
POST {{baseURL}}/chamados
Accept: application/json
content-type: application/json

### Criar chamado com dados inválidos
POST {{baseURL}}/chamados
Accept: application/json
content-type: application/json

{
  "titulo": "Monitor com tela piscando",
  "descricao": "O monitor apresenta oscilações na imagem durante o uso.",
  "prioridade": "ALTA",
  "solicitanteId": "nan",
  "categoriaId": "nan"
}

### Buscar chamado por id
GET {{baseURL}}/chamados/1
Accept: application/json

### Buscar chamado com id inválido
GET {{baseURL}}/chamados/nan
Accept: application/json

### Atualizar chamado
PATCH {{baseURL}}/chamados/1
Accept: application/json
content-type: application/json

{
  "prioridade": "MEDIA",
  "status": "CONCLUIDO",
  "solucao": "Fonte deve ser substituída.",
  "tecnicoId": 1
}

### Atualizar somente solução do chamado
PATCH {{baseURL}}/chamados/1
Accept: application/json
content-type: application/json

{
  "solucao": "Fonte e placa mãe devem ser substituídos."
}

### Apagar chamado
DELETE {{baseURL}}/chamados/1